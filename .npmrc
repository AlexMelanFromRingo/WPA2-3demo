# Защита цепочки поставок npm — кампания Shai-Hulud активна (research.md R3).
# Блокирует автозапуск вредоноса через lifecycle-скрипты pre/post/install:
ignore-scripts=true
# Карантин: ставить только версии, опубликованные более 7 дней назад
# (min-release-age измеряется в ДНЯХ). Отсекает свежие, ещё не отозванные волны:
min-release-age=7
# Любая будущая `npm install <pkg>` сохраняет точную версию без ^/~:
save-exact=true
audit=true
fund=false
